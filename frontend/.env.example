# Em produção same-origin, deixe vazio. Para Vite separado, use a URL HTTPS da API.
VITE_API_BASE_URL=

# O protótipo usa World Imagery por padrão. Troque por um provedor/licença próprios.
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_SATELLITE_ATTRIBUTION=Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics
